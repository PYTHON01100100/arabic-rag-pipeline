# Arabic RAG Pipeline - Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# LLM Provider Selection (auto, gemini, vllm, or ollama)
# ============================================================================
# auto   = Automatically select first available (vLLM > Ollama > Gemini)
# gemini = Use Google Gemini API (requires GEMINI_API_KEY)
# vllm   = Use vLLM server (local)
# ollama = Use Ollama server (local)
LLM_PROVIDER=auto

# ============================================================================
# Option 1: Google Gemini API (easiest for getting started)
# ============================================================================
# Get free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# Option 2: Ollama (local, free, no API key needed)
# ============================================================================
# Install from: https://ollama.ai
# Run: ollama run llama2-arabic (or any Arabic-capable model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7

# ============================================================================
# Option 3: vLLM (local, fast, OpenAI-compatible)
# ============================================================================
# Use docker-compose with vllm service, or run separately
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-needed
VLLM_MODEL=meta-llama/Llama-2-7b-chat-hf
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.7

# ============================================================================
# Optional: Streamlit Configuration
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_CLIENT_LOGGING_LEVEL=info

# ============================================================================
# Optional: Python Configuration
# ============================================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# Optional: Database Configuration
# ============================================================================
# ChromaDB will store data in ./streamlit_chroma_db by default
CHROMA_DB_PATH=./streamlit_chroma_db

# ============================================================================
# Optional: AWS/Cloud Configuration (if deploying to AWS)
# ============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ============================================================================
# Optional: Container Resource Limits
# ============================================================================
# These are typically set at the container runtime level, not in env vars
# But can be useful for reference
# MEMORY_LIMIT=2Gi
# CPU_LIMIT=2000m
